@model ConsoliSQL.Models.Consolidated

@{
    ViewBag.Title = "Consolidated";
}

<script src="~/Scripts/viz.js"></script>
<script src="~/Scripts/svg-pan-zoom.js"></script>

<script>
    var svg = $(Viz("@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.DotNotation))", { format: "svg" })).addClass("dot-svg");
    $(".body-content").append(svg);

    svgPanZoom(".dot-svg", {
        controlIconsEnabled: true,
        maxZoom: 10000
    });

    function GetDateTime() {
        var isoDate = new Date().toISOString();
        var date = isoDate.slice(0, 10);
        var time = isoDate.slice(11, 19);

        return date + " " + time;
    }

    var urlObject = window.URL.createObjectURL(new Blob(["@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Script))"], { type: "text/plain" }));

    $(".body-content").append(
        $("<h4>").addClass("text-right").append(
            $("<a>").html("Download ready ")
                .attr("id", "sql-download-link")
                .attr("href", urlObject)
                .attr("download", "EasySQL " + GetDateTime() + ".sql")
                .append($("<span>")
                    .addClass("glyphicon glyphicon-download"))));
</script>

<hr />

@if (Model.ScriptFiles.Any(x => x.ParseErrors.Any()))
{
    <div class="alert alert-warning">
        <strong>Warning!</strong> There were errors when trying to parse @(Model.ScriptFiles.Count(x => x.ParseErrors.Any())) file(s).
    </div>
}
else
{
    <div class="alert alert-success">
        <strong>Success!</strong> @Model.ScriptFiles.Count() scripts were parsed and consolidated successfully!
    </div>
}

@functions { 
    private static string GetSqlObjectIconPath(ConsoliSQL.Models.SqlObjectType type)
    {
        switch (type)
        {
            case ConsoliSQL.Models.SqlObjectType.Table: return "~/Content/Images/Table.png";
            case ConsoliSQL.Models.SqlObjectType.View: return "~/Content/Images/View.png";
            case ConsoliSQL.Models.SqlObjectType.TableOrView: return "~/Content/Images/TableOrView.gif";
            case ConsoliSQL.Models.SqlObjectType.Index: return "~/Content/Images/Index.png";
            case ConsoliSQL.Models.SqlObjectType.ScalarFunction: return "~/Content/Images/ScalarFunction.png";
            case ConsoliSQL.Models.SqlObjectType.TableValuedFunction: return "~/Content/Images/TableFunction.png";
            case ConsoliSQL.Models.SqlObjectType.InlineTableValuedFunction:
            case ConsoliSQL.Models.SqlObjectType.Procedure: return "~/Content/Images/Procedure.png";
            case ConsoliSQL.Models.SqlObjectType.Trigger: return "~/Content/Images/Trigger.png";
                
            default: return "";
        }
    }
}

@foreach (var scriptFile in Model.ScriptFiles)
{
    <ul>
        <li data-overview="@scriptFile.Overview">
            <b class="@(scriptFile.ParseErrors.Count() > 0 ? "text-danger" : "")">@scriptFile.FileName<span class="@(scriptFile.ParseErrors.Count() > 0 ? "glyphicon glyphicon-exclamation-sign" : "")" data-toggle="tooltip" title="@string.Join(Environment.NewLine, scriptFile.ParseErrors)"></span></b>
            <span class="glyphicon glyphicon-search pull-right" role="button"></span>
        </li>
        @if (scriptFile.Creates.Count() > 0)
        {
            <li>
                <i>Creates</i>
                <ul>
                    @foreach (var createObject in scriptFile.Creates)
                    {
                        var createObjectName = createObject.Type.GetSqlObjectName();
                        <li><img src="@Url.Content(GetSqlObjectIconPath(createObject.Type))" alt="@createObjectName" data-toggle="tooltip" title="@createObjectName" /> @createObject.Name</li>
                    }
                </ul>
            </li>
        }
        @if (scriptFile.DependsOn.Count() > 0)
        {
            <li>
                <i>Depends On</i>
                <ul>
                    @foreach (var dependsObject in scriptFile.DependsOn)
                    {
                        var dependsObjectName = dependsObject.Type.GetSqlObjectName();
                        <li><img src="@Url.Content(GetSqlObjectIconPath(dependsObject.Type))" alt="@dependsObjectName" data-toggle="tooltip" title="@dependsObjectName" /> @dependsObject.Name</li>
                    }
                </ul>
            </li>
        }
    </ul>
}

<textarea id="order-output" class="form-control order-output" spellcheck="false">@(string.Join(Environment.NewLine, Model.ScriptFiles.Select(x => x.FileName)))</textarea>

<script>
    $("[data-toggle='tooltip']").tooltip();

    $("ul > li > .glyphicon-search").click(function () {
        var newWindow = window.open();
        newWindow.document.write($("<pre>").append($(this).parent().data("overview"))[0].outerHTML);
    });
</script>
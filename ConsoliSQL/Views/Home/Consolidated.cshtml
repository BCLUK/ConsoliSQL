@model ConsoliSQL.Models.Consolidated

<div class="dot-container"></div>
<h4 class="text-right">
    <a id="sql-download-link" href="#">Download ready <span class="glyphicon glyphicon-download"></span></a>
</h4>

<hr />

@if (Model.ScriptFiles.Any(x => x.ParseErrors.Any()))
{
    <div class="alert alert-warning">
        <strong>Warning!</strong> There were errors when trying to parse @(Model.ScriptFiles.Count(x => x.ParseErrors.Any())) file(s).
    </div>
}
else
{
    <div class="alert alert-success">
        <strong>Success!</strong> @Model.ScriptFiles.Count() scripts were parsed and consolidated successfully!
    </div>
}

@functions {
    private static string GetSqlObjectIconPath(ConsoliSQL.Models.SqlObjectType type)
    {
        switch (type)
        {
            case ConsoliSQL.Models.SqlObjectType.Table:
            case ConsoliSQL.Models.SqlObjectType.TableValueParameter: return "~/Content/Images/Table.png";
            case ConsoliSQL.Models.SqlObjectType.View: return "~/Content/Images/View.png";
            case ConsoliSQL.Models.SqlObjectType.TableOrView: return "~/Content/Images/TableOrView.gif";
            case ConsoliSQL.Models.SqlObjectType.Index: return "~/Content/Images/Index.png";
            case ConsoliSQL.Models.SqlObjectType.ScalarFunction: return "~/Content/Images/ScalarFunction.png";
            case ConsoliSQL.Models.SqlObjectType.TableValuedFunction:
            case ConsoliSQL.Models.SqlObjectType.InlineTableValuedFunction:
            case ConsoliSQL.Models.SqlObjectType.TableFunction: return "~/Content/Images/TableFunction.png";
            case ConsoliSQL.Models.SqlObjectType.Procedure: return "~/Content/Images/Procedure.png";
            case ConsoliSQL.Models.SqlObjectType.Trigger: return "~/Content/Images/Trigger.png";
            case ConsoliSQL.Models.SqlObjectType.Column: return "~/Content/Images/Column.png";

            default: return "";
        }
    }
}

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-target="#dependency-summary" role="button">Dependency Summary</div>
        <div class="panel-collapse collapse" id="dependency-summary">
            <div class="panel-body">
                @foreach (var scriptFile in Model.ScriptFiles)
                {
                    <ul>
                        <li data-overview="@scriptFile.Overview">
                            <b class="@(scriptFile.ParseErrors.Count() > 0 ? "text-danger" : "")">@scriptFile.FileName <span class="@(scriptFile.ParseErrors.Count() > 0 ? "glyphicon glyphicon-exclamation-sign" : "")" data-toggle="tooltip" title="@string.Join(Environment.NewLine, scriptFile.ParseErrors)"></span></b>
                            <span class="glyphicon glyphicon-search pull-right" role="button"></span>
                        </li>
                        @if (scriptFile.Creates.Count() > 0)
                        {
                            <li>
                                <i>Creates</i>
                                <ul>
                                    @foreach (var createObject in scriptFile.Creates)
                                    {
                                        var createObjectName = createObject.Type.GetSqlObjectName();
                                        var iconPath = GetSqlObjectIconPath(createObject.Type);
                                        var imgSrc = string.IsNullOrEmpty(iconPath) ? "" : @Url.Content(iconPath);
                                        <li><img src="@imgSrc" alt="@createObjectName" data-toggle="tooltip" title="@createObjectName" /> @createObject.Name</li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (scriptFile.DependsOn.Count() > 0)
                        {
                            <li>
                                <i>Depends On</i>
                                <ul>
                                    @foreach (var dependsObject in scriptFile.DependsOn)
                                    {
                                        var dependsObjectName = dependsObject.Type.GetSqlObjectName();
                                        var iconPath = GetSqlObjectIconPath(dependsObject.Type);
                                        var imgSrc = string.IsNullOrEmpty(iconPath) ? "" : @Url.Content(iconPath);
                                        <li><img src="@imgSrc" alt="@dependsObjectName" data-toggle="tooltip" title="@dependsObjectName" /> @dependsObject.Name</li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading" data-toggle="collapse" data-target="#scripts-order" role="button">Scripts Order</div>
        <div class="panel-collapse collapse" id="scripts-order">
            <div class="panel-body">
                <textarea id="order-output" class="form-control order-output" spellcheck="false">@(string.Join(Environment.NewLine, Model.ScriptFiles.Select(x => x.FileName)))</textarea>
            </div>
        </div>
    </div>
    @if (Model.ScriptFiles.Any(x => x.ParseErrors.Any()))
    {
        <div class="panel panel-default">
            <div class="panel-heading" data-toggle="collapse" data-target="#parse-errors" role="button">Parse Errors</div>
            <div class="panel-collapse collapse" id="parse-errors">
                <div class="panel-body">
                    @foreach (var scriptFile in Model.ScriptFiles.Where(x => x.ParseErrors.Any()))
                    {
                        <ul>
                            <li data-overview="@scriptFile.Overview">
                                <strong>@scriptFile.FileName</strong>
                                <span class="glyphicon glyphicon-search pull-right" role="button"></span>
                                <ul>
                                    @foreach (var parseError in scriptFile.ParseErrors)
                                    {
                                        <li>@parseError</li>
                                    }
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

<script src="~/Scripts/viz.js"></script>
<script src="~/Scripts/svg-pan-zoom.js"></script>

<script>
    var svg = $(Viz("@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.DotNotation))", { format: "svg" })).addClass("dot-svg");
    $(".dot-container").append(svg);

    svgPanZoom(".dot-svg", {
        controlIconsEnabled: true,
        maxZoom: 1000
    });

    function GetDateTime() {
        var isoDate = new Date().toISOString();
        var date = isoDate.slice(0, 10);
        var time = isoDate.slice(11, 19);

        return date + " " + time;
    }

    var blob = new Blob(["@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Script))"], { type: "text/plain" });

    if (window.navigator.msSaveOrOpenBlob) {
        $("#sql-download-link").click(function () {
            window.navigator.msSaveOrOpenBlob(blob, "ConsoliSQL " + GetDateTime() + ".sql");
        });
    } else {
        var urlObject = window.URL.createObjectURL(blob);

        $("#sql-download-link")
            .attr("href", urlObject)
            .attr("download", "ConsoliSQL " + GetDateTime() + ".sql");
    }

    $("[data-toggle='tooltip']").tooltip();

    $("ul > li > .glyphicon-search").click(function () {
        var newWindow = window.open();
        newWindow.document.write($("<pre>").append($(this).parent().data("overview"))[0].outerHTML);
    });
</script>
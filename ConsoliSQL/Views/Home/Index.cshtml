@model ConsoliSQL.Models.Home

@{
    ViewBag.Title = "Home";
}

<h2>@ViewBag.Title</h2>
<hr />
<h5>Upload SQL scripts and let the tool do the rest of the work...</h5>

@using (Html.BeginForm("Index", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group upload-form-group">
        <div class="form-inline">
            <div class="form-group">
                <input id="files-input" type="file" class="hide" multiple accept=".sql" />
                <input id="files-button" type="button" class="btn btn-default" value="Upload Files" />
            </div>
            <div class="form-group">
                <input id="directory-input" type="file" class="hide" webkitdirectory directory mozdirectory />
                <input id="directory-button" type="button" class="btn btn-default" value="Upload Directory" />
            </div>
        </div>
        @Html.ValidationMessageFor(x => x.Files, null, new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <div id="drag-drop-helper" class="drag-drop">
            <h4 id="drag-drop-helper-text">Drop files here...</h4>
            <div class="row" id="files"></div>
        </div>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.ErrorChecking) Add error checking</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Wraps everything in a transaction and appends an @("@@")ERROR check to every batch. Everything will be rolled back in the event of an error."></span>
    </div>
    
    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.NormaliseLineEndings, new { @checked = "checked" }) Normalise line endings</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Makes sure all line endings are the same (\r\n) whilst stopping that pesky SSMS line endings message from popping up!"></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.CaseSensitive) Case sensitive</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="EXAMPLE_OBJECT and example_object will be seen as two unique objects."></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.PrependDrops, new { id = "prepend-drops-checkbox" }) Prepend IF EXISTS DROP</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Prepends an existance/drop check to every script that creates an object."></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.DropsAtTop, new { id = "drops-at-top-checkbox", disabled = "disabled" }) Script drops at top</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Scripts all the if exists drop statements at the top of the generated script instead of before each individual script."></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.AllowCircularDependies) Allow circular dependencies</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Ignores errors caused by scripts depending on each other. These scripts will be in no particular order."></span>
    </div>

    <input class="btn btn-default" type="submit" value="Consolidate" />
}

<hr />

<p>Known issues...</p>

<ul>
    <li>
        Doesn't take schemas into consideration.
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="For example: creating a view named 'sysobjects' on the 'dbo' schema will be excluded because a system view with the same name exists on the 'sys' schema."></span>
    </li>
    <li>
        Common table expressions are seen as dependant objects.
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Will only be a problem if you have a table with the same name as a common table expression."></span>
    </li>
</ul>

@section scripts {
    <script src="~/Scripts/jquery.signalR-2.2.2.min.js"></script>
    <script src="~/signalr/hubs"></script>

    <script>
        $(function () {
            $("body").on("dragover", function (e) {
                e.stopPropagation();
                e.preventDefault();
                e.originalEvent.dataTransfer.dropEffect = "none";
            });

            $("#drag-drop-helper").on("dragenter", function (e) {
                if ($(this).is(e.target) || $(this).has(e.target)) {
                    $(this).addClass("drag-over");
                }
            })
            .on("dragleave", function (e) {
                if ($(this).is(e.target)) {
                    $(this).removeClass("drag-over");
                }
            })
            .on("dragover", function (e) {
                e.stopPropagation();
                e.preventDefault();
                e.originalEvent.dataTransfer.dropEffect = "copy";
            })
            .on("drop", function (e) {
                e.stopPropagation();
                e.preventDefault();

                $(this).removeClass("drag-over");

                for (var i = 0; i < e.originalEvent.dataTransfer.items.length; i++) {
                    var item = e.originalEvent.dataTransfer.items[i].webkitGetAsEntry();
                    iterateIOItems(item);
                }
            });

            function iterateIOItems(item) {
                if (item.isDirectory) {
                    var dirReader = item.createReader();
                    readIOItems(dirReader);
                } else if (item.isFile) {
                    if (/.sql$/.test(item.name.toLowerCase())) {
                        item.file(function (file) {
                            addFile(file);
                        });
                    }
                }
            }

            function readIOItems(dirReader) {
                dirReader.readEntries(function (items) {
                    if (items.length > 0) {
                        for (var i = 0; i < items.length; i++) {
                            iterateIOItems(items[i]);
                        }

                        readIOItems(dirReader);
                    }
                });
            }

            $("#prepend-drops-checkbox").click(function () {
                $("#drops-at-top-checkbox").prop("disabled", !$(this).is(":checked"));
            });
        });

        function isInputDirSupported() {
            var tmpInput = document.createElement("input");
            if ("webkitdirectory" in tmpInput
                || "mozdirectory" in tmpInput
                || "odirectory" in tmpInput
                || "msdirectory" in tmpInput
                || "directory" in tmpInput) return true;

            return false;
        }

        if (!isInputDirSupported()) {
            $(".form-inline > .form-group:has(#directory-input)").hide();
        }

        var selectedFiles = [];

        $("#files-button").click(function () {
            $("#files-input").click();
        });

        $("#directory-button").click(function () {
            $("#directory-input").click();
        });

        var $dragDropHelperText = $("#drag-drop-helper-text");

        var addFile = function (file) {
            selectedFiles.push(file);

            $("#files").append($("<div>")
                .addClass("col-md-3")
                .append($("<div>")
                    .addClass("file-delete")
                    .append($("<span>")
                        .addClass("close")
                        .html("&times;")
                        .data("file", file)
                        .click(removeFile)))
                .append($("<div>")
                    .addClass("file-name")
                    .prop("title", file.name)
                    .html(file.name)));

            if (selectedFiles.length > 0) {
                $("#drag-drop-helper").addClass("borderless");
                $dragDropHelperText.addClass("hide");
            }
        };

        var removeFile = function () {
            selectedFiles.splice(selectedFiles.indexOf($(this).data("file")), 1);
            $(this).parent().parent().remove();

            if (selectedFiles.length < 1) {
                $("#drag-drop-helper").removeClass("borderless");
                $dragDropHelperText.removeClass("hide");
            }
        };

        $("#files-input, #directory-input").change(function () {
            var files = $(this).prop("files");

            for (var i = 0; i < files.length; i++) {
                if (/.sql$/.test(files[i].name.toLowerCase())) {
                    addFile(files[i]);
                }
            }
        });

        $("form").submit(function () {
            var formData = new FormData(this);

            for (var i = 0; i < selectedFiles.length; i++) {
                formData.append("Files", selectedFiles[i]);
            }

            var modal = $("<div>")
                .addClass("modal fade")
                .append($("<div>")
                    .addClass("modal-dialog")
                    .append($("<div>")
                        .addClass("modal-content")
                        .append($("<div>")
                            .addClass("modal-body")
                            .append($("<h1>")
                                .addClass("text-center")
                                .html("Consolidating"))
                            .append($("<hr>"))
                            .append($("<p>")
                                .addClass("text-center file-name"))
                            .append($("<div>")
                                .addClass("progress consolidate-progress")
                                .append($("<div>")
                                    .addClass("progress-bar progress-bar-striped active"))))))
                .on("hidden.bs.modal", function () {
                    $(this).remove();
                });

            $.ajax({
                url: "@Url.Action("Index")",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (data) {
                    $(".body-content").html(data);
                    modal.modal("hide");
                }
            });

            modal.modal({
                backdrop: "static",
                keyboard: false
            });

            var hub = $.connection.consolidateProgressHub;

            hub.client.reportProgress = function (scriptFile, labelPercent, percent) {
                var pBar = modal.find(".progress-bar")
                    .css("width", percent + "%")
                    .html(labelPercent + "%");

                modal.find(".file-name").html(scriptFile);
            };

            $.connection.hub.start();

            return false;
        });

        $("[data-toggle='tooltip']").tooltip();
    </script>
}
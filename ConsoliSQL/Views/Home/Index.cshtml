@model ConsoliSQL.Models.Home

@{
    ViewBag.Title = "Home";
}

<h5>Upload SQL scripts and let the tool do the rest of the work...</h5>

@using (Html.BeginForm("Index", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        <div class="form-inline">
            <div class="form-group">
                <input id="files-input" type="file" class="hide" multiple accept=".sql" />
                <input id="files-button" type="button" class="btn btn-default" value="+ Upload Files" />
            </div>
            <div class="form-group">
                <input id="directory-input" type="file" class="hide" webkitdirectory directory mozdirectory />
                <input id="directory-button" type="button" class="btn btn-default" value="+ Upload Directory" />
            </div>
        </div>
        @Html.ValidationMessageFor(x => x.Files, null, new { @class = "text-danger" })
    </div>

    <div class="form-group hide">
        <div class="well">
            <div class="row" id="files"></div>
        </div>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.WrapTransaction) Wrap scripts in a transaction</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Wraps all the consolidated scripts in a transaction so you can easily rollback on error."></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.AppendGo) Append 'GO' to every script</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Appends 'GO' to every script, does not check if 'GO' already exists."></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.NormaliseLineEndings) Normalise line endings</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Makes sure all line endings are the same (\r\n) whilst stopping that pesky SSMS line endings message from popping up!"></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.CaseSensitive) Case sensitive</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="EXAMPLE_OBJECT and example_object will be seen as two unique objects."></span>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.PrependDrops) Prepend IF EXISTS DROP</label>
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Prepends an existance/drop check to every script that creates an object."></span>
    </div>

    <input class="btn btn-default" type="submit" value="Consolidate" />
}

<script>
    function isInputDirSupported() {
        var tmpInput = document.createElement("input");
        if ("webkitdirectory" in tmpInput
            || "mozdirectory" in tmpInput
            || "odirectory" in tmpInput
            || "msdirectory" in tmpInput
            || "directory" in tmpInput) return true;

        return false;
    }

    if (!isInputDirSupported()) {
        $(".form-inline > .form-group:has(#directory-input)").hide();
    }

    var selectedFiles = [];

    $("#files-button").click(function () {
        $("#files-input").click();
    });

    $("#directory-button").click(function () {
        $("#directory-input").click();
    });

    var removeFile = function () {
        selectedFiles.splice(selectedFiles.indexOf($(this).data("file")), 1);
        updateFiles();
    };

    var updateFiles = function () {
        $("#files").empty();

        for (var i = 0; i < selectedFiles.length; i++) {
            $("#files").append($("<div>")
                .addClass("col-md-3")
                .append($("<div>")
                    .addClass("file-delete")
                    .append($("<span>")
                        .addClass("close")
                        .html("&times;")
                        .data("file", selectedFiles[i])
                        .click(removeFile)))
                .append($("<div>")
                    .addClass("file-name")
                    .prop("title", selectedFiles[i].name)
                    .html(selectedFiles[i].name)));
        }

        $(".form-group:has(#files)").toggleClass("hide", selectedFiles.length < 1);
    };

    $("#files-input, #directory-input").change(function () {
        var files = $(this).prop("files");

        for (var i = 0; i < files.length; i++) {
            if (/.sql$/.test(files[i].name.toLowerCase())) {
                selectedFiles.push(files[i]);
            }
        }

        updateFiles();
    });

    $("form").submit(function () {
        var formData = new FormData($(this).serialize());

        for (var i = 0; i < selectedFiles.length; i++) {
            formData.append("Files", selectedFiles[i]);
        }

        $.ajax({
            url: "@Url.Action("Index")",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                document.write(data);
            }
        });
        
        return false;
    });
</script>

<hr />

<p>Known issues...</p>

<ul>
    <li>
        Doesn't take schemas into consideration.
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="For example: creating a view named 'sysobjects' on the 'dbo' schema will be excluded because a system view with the same name exists on the 'sys' schema."></span>
    </li>
    <li>
        Common table expressions are seen as dependant objects.
        <span class="glyphicon glyphicon-info-sign" data-toggle="tooltip" title="Will only be a problem if you have a table with the same name as a common table expression."></span>
    </li>
</ul>

<script>
    $("[data-toggle='tooltip']").tooltip();
</script>